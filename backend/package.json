{
  "name": "jaboatao-360-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local servidor.mjs",
    "migrate": "node --env-file-if-exists=.env.local banco/migrar.mjs",
    "test": "node --env-file-if-exists=.env.teste.local --test verificar-email.test.mjs banco/contas.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "build": "node scripts/build.mjs",
    "start:dist": "node --env-file-if-exists=.env.local dist/servidor.mjs",
    "migrate:dist": "node --env-file-if-exists=.env.local dist/migrar.mjs"
  },
  "dependencies": {
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "rolldown": "1.2.15"
  }
}
