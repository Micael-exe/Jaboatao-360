# Opcional. GET retorna uma lista de locais no formato usado em src/mapa/catalogo.js
# ou um objeto com a propriedade "locais" contendo essa lista.
# Exemplo: {"id":"m1","nome":"Museu","tags":["Museu"],"lat":-8.17,"lng":-34.92,"foto":"/fotos/museu.webp","duracaoMin":30,"horarios":{"0":[],"1":[["10:00","14:00"]],"6":[["12:00","15:00"]]}}
# Dias de 0 (domingo) a 6 (sábado). [] significa fechado; dia ausente indica horário a confirmar.
VITE_MAPA_LOCAIS_URL=
# Servidor OSRM com perfil de carro. Em produção, use a instância da equipe.
VITE_MAPA_OSRM_URL=https://router.project-osrm.org
